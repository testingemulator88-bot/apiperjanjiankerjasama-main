#Gambar Foto
RewriteRule ^maps_parastapainnovation_foto-([Foto]+)$ uploadedfile/filenya_foto/index.php [L]


#Legenda Web GIS Simfast
#getlegenda
RewriteRule ^maps_legend-([ShowLegenda]+)$ legendapeta/001_getdatalegendalayers.php [L]

