
# aProtect the .htaccess
<files .htaccess="">
order allow,deny
deny from all
</files>


RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

#error
RewriteRule ^warning-([error]+)$ error.php [L]

#IP SISTEM
RewriteRule ^parastapainnovationip-([Key]+)$ ip/000_ip.php [L]
#Login SISTEM
RewriteRule ^parastapainnovation-([login]+)$ main/login/001_login.php [L]
## USER
#getalluser
RewriteRule ^parastapainnovation-([GetAllUser]+)$ main/user/000_getuser.php [L]
#level
RewriteRule ^parastapainnovation-([GetAllLevel]+)$ main/user/000a_getuserlevel.php [L]
#getuser
RewriteRule ^parastapainnovationUser-([GetUser]+)$ main/user/001_getuserbyid.php [L]
#getuserbyid
RewriteRule ^parastapainnovationuserNonMD5-([GetUser]+)$ main/user/001a_getuserbyIDNormal.php [L]
#getusername
RewriteRule ^parastapainnovation-([GetDataUserName]+)$ main/user/003_getusernamebyid.php [L]
#ubahuser
RewriteRule ^parastapainnovation-([ChangeUserPassword]+)$ main/user/002_UpdateUserById.php [L]
#Gambar user
RewriteRule ^view_parastapainnovation-([GambarUser]+)$ uploadedfile/filenya_user/index.php [L]
#Tambah user
RewriteRule ^parastapainnovationuser-([AddUser]+)$ main/user/004_AddUser.php [L]
#Edit user
RewriteRule ^parastapainnovationuser-([EditUser]+)$ main/user/005_EditUser.php [L]
#delete user
RewriteRule ^parastapainnovationuser-([DeleteUser]+)$ main/user/000b_DeleteUserData.php [L]
#Reffuser
RewriteRule ^parastapainnovation-([ReffUser]+)$ main/user/006_RefUser.php [L]

##### FILE #####
#UPLOAD FILE
RewriteRule ^parastapainnovationpeta-([FilesUpload]+)$ main/FilesUpload/001_Upload.php [L]
#DELETED FILE
RewriteRule ^parastapainnovationpeta-([FilesDeleted]+)$ main/FilesUpload/002_Delete.php [L]

#Web GIS Simfast
#getLayer
RewriteRule ^maps_parastapainnovation-([LayerPeta]+)$ webgis/001_getdatalayers.php [L]
