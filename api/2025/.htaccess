RewriteRule ^maps_titik_emon-([TitikEmon]+)$ webgis/lokasiemon/001_lokasi_emon.php [L]
#point pk
RewriteRule ^maps_titik_pk-([TitikPK]+)$ webgis/lokasipk/001_lokasi_pk.php [L]
